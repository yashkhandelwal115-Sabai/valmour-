[
  {
    "name": "theme_info",
    "theme_name": "Velour",
    "theme_author": "Velour Theme Developer",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://support.shopify.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 250,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "Custom logo width"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#C9A96E"
      },
      {
        "type": "color",
        "id": "color_accent_foreground",
        "label": "Accent foreground",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Primary button",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Primary button label",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "helvetica_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "helvetica_n4"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter/X"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_linkedin_link",
        "label": "LinkedIn"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          },
          {
            "value": "modal",
            "label": "Modal"
          }
        ],
        "default": "drawer"
      }
    ]
  }
]
