<ul class="social-icons" role="list">
  {%- if settings.social_facebook_link != blank -%}
    <li><a href="{{ settings.social_facebook_link }}" class="social-icons__link" aria-describedby="a11y-external-message">Facebook</a></li>
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    <li><a href="{{ settings.social_instagram_link }}" class="social-icons__link" aria-describedby="a11y-external-message">Instagram</a></li>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    <li><a href="{{ settings.social_youtube_link }}" class="social-icons__link" aria-describedby="a11y-external-message">YouTube</a></li>
  {%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}
    <li><a href="{{ settings.social_tiktok_link }}" class="social-icons__link" aria-describedby="a11y-external-message">TikTok</a></li>
  {%- endif -%}
  {%- if settings.social_twitter_link != blank -%}
    <li><a href="{{ settings.social_twitter_link }}" class="social-icons__link" aria-describedby="a11y-external-message">Twitter</a></li>
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}
    <li><a href="{{ settings.social_pinterest_link }}" class="social-icons__link" aria-describedby="a11y-external-message">Pinterest</a></li>
  {%- endif -%}
  {%- if settings.social_linkedin_link != blank -%}
    <li><a href="{{ settings.social_linkedin_link }}" class="social-icons__link" aria-describedby="a11y-external-message">LinkedIn</a></li>
  {%- endif -%}
</ul>
