{% if template.name == 'index' %}
  <div id="velour-preloader" class="velour-preloader">
    
    <!-- Image Stack -->
    <div class="velour-preloader__images" id="preloader-images">
      <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=800&auto=format&fit=crop" class="preloader-img" alt="Preloader Image">
      <img src="https://images.unsplash.com/photo-1492447166138-50c3889fccb1?q=80&w=800&auto=format&fit=crop" class="preloader-img" alt="Preloader Image">
      <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=800&auto=format&fit=crop" class="preloader-img" alt="Preloader Image">
      <img src="https://images.unsplash.com/photo-1539008835657-9e8e9680c956?q=80&w=800&auto=format&fit=crop" class="preloader-img" alt="Preloader Image">
      <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=800&auto=format&fit=crop" class="preloader-img" alt="Preloader Image">
    </div>

    <!-- Massive Text -->
    <div class="velour-preloader__text-container">
      <h1 class="velour-preloader__text">VELOUR</h1>
    </div>
    
    <!-- Design Accents -->
    <span class="velour-preloader__plus">{% render 'icon-heart' %}</span>

    <!-- Counter -->
    <div class="velour-preloader__counter" id="preloader-counter">000</div>
    
  </div>

  <script>
    if (sessionStorage.getItem('velour_preloader_played') === 'true') {
      const preloader = document.getElementById('velour-preloader');
      if (preloader) preloader.style.display = 'none';
      document.body.classList.add('preloader-finished');
    }
  </script>
{% endif %}
