<div class="product-card">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__link-overlay"><span class="visually-hidden">{{ product.title }}</span></a>
    
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 768px) 25vw, 50vw', class: 'product-card__image product-card__image--primary' }}
      {% if product.media[1] != nil %}
        {{ product.media[1] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 768px) 25vw, 50vw', class: 'product-card__image product-card__image--secondary' }}
      {% endif %}
    {% else %}
      {% assign mod_index = fallback_index | modulo: 8 %}
      {% if mod_index == 1 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1594744803329-e58b31de8bf5?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Relaxed Wool Blazer' %}
        {% assign fallback_price = '$299.00' %}
      {% elsif mod_index == 2 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1620799140188-3b2a02fd9a77?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Merino Half-Zip Sweater' %}
        {% assign fallback_price = '$189.00' %}
      {% elsif mod_index == 3 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1599839619722-39751411ea63?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Silk Button-Down Shirt' %}
        {% assign fallback_price = '$249.00' %}
      {% elsif mod_index == 4 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1593030761757-71fae45fa0e7?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Tailored Suit Jacket' %}
        {% assign fallback_price = '$399.00' %}
      {% elsif mod_index == 5 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1584916201218-f4242ceb4809?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Leather Tote Bag' %}
        {% assign fallback_price = '$229.00' %}
      {% elsif mod_index == 6 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1509631179647-0c500ba14174?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Pleated Wide Leg Pants' %}
        {% assign fallback_price = '$199.00' %}
      {% elsif mod_index == 7 %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1572804013309-59a88b7e92f1?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Satin Slip Dress' %}
        {% assign fallback_price = '$189.00' %}
      {% else %}
        {% assign fallback_src = 'https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=600&auto=format&fit=crop' %}
        {% assign fallback_title = 'Minimal Leather Sneakers' %}
        {% assign fallback_price = '$159.00' %}
      {% endif %}
      <img src="{{ fallback_src }}" srcset="{{ fallback_src | replace: 'w=600', 'w=200' }} 200w, {{ fallback_src | replace: 'w=600', 'w=400' }} 400w, {{ fallback_src }} 600w" sizes="(min-width: 768px) 25vw, 50vw" width="600" height="800" loading="lazy" class="product-card__image product-card__image--primary" style="width: 100%; height: 100%; object-fit: cover;" alt="{{ fallback_title }}">
    {% endif %}
    
    <div class="product-card__badges">
      {% if product.compare_at_price > product.price %}
        <span class="product-card__badge product-card__badge--sale">Sale</span>
      {% elsif product.available == false %}
        <span class="product-card__badge product-card__badge--sold-out">Sold out</span>
      {% endif %}
    </div>


  </div>

  <div class="product-card__info-wrapper">
    <a href="{{ product.url | default: '#' }}" class="product-card__info-link">
      <div class="product-card__info">
        <h3 class="product-card__title">{% if product %}{{ product.title }}{% else %}{{ fallback_title }}{% endif %}</h3>
        {% if product %}
          {% render 'price', product: product %}
        {% else %}
          <div class="price"><span class="price__regular" style="color:var(--color-text);">{{ fallback_price }}</span></div>
        {% endif %}
      </div>
    </a>
    


    <div class="product-card__action-bottom">
      {% if product == nil %}
        <a href="{{ routes.cart_url }}" class="button button--outlined product-card__quick-add" style="text-decoration:none; display:flex; align-items:center; justify-content:center;" onclick="alert('This is a demo product. In a real store, it would be added to your cart.');">
          {% render 'icon-cart' %} <span style="margin-left:8px;">Add to cart</span>
        </a>
      {% elsif product.available != false %}
        <form method="post" action="{{ routes.cart_add_url }}" class="product-card__form">
          <input type="hidden" name="return_to" value="/cart" />
          {% unless product.has_only_default_variant %}
            <div class="product-card__options" style="margin-bottom: 15px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 15px; align-items: start; text-align: left;">
              {% for option in product.options_with_values %}
                <div class="product-card__option-group">
                  <div class="product-card__option-label" style="font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; color: var(--color-muted); font-weight: 600;">{{ option.name }}</div>
                  {% assign downcase_name = option.name | downcase %}
                  {% if downcase_name == 'size' %}
                    <select class="product-card__option-select" name="options[{{ option.name | escape }}]" data-option-position="{{ option.position | minus: 1 }}" aria-label="{{ option.name }}" style="width: 100%; padding: 8px; border: 1px solid var(--color-border, #e0e0e0); background: var(--color-background, #fff); color: var(--color-text, #333); font-size: 12px; font-family: inherit; text-transform: capitalize;">
                      {% assign all_sizes = "XS,S,M,L,XL" | split: "," %}
                      {% for f_size in all_sizes %}
                        {% assign is_available = false %}
                        {% for variant in product.variants %}
                          {% assign opt_idx = option.position | minus: 1 %}
                          {% if variant.options[opt_idx] == f_size and variant.available %}
                            {% assign is_available = true %}
                          {% endif %}
                        {% endfor %}
                        <option value="{{ f_size | escape }}" {% if option.selected_value == f_size %}selected="selected"{% endif %} {% unless is_available %}disabled{% endunless %}>
                          {{ f_size }}{% unless is_available %} - Out of stock{% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  {% else %}
                    <select class="product-card__option-select" name="options[{{ option.name | escape }}]" data-option-position="{{ option.position | minus: 1 }}" aria-label="{{ option.name }}" style="width: 100%; padding: 8px; border: 1px solid var(--color-border, #e0e0e0); background: var(--color-background, #fff); color: var(--color-text, #333); font-size: 12px; font-family: inherit; text-transform: capitalize;">
                      {% for value in option.values %}
                        {% assign is_available = false %}
                        {% for variant in product.variants %}
                          {% assign opt_idx = option.position | minus: 1 %}
                          {% if variant.options[opt_idx] == value and variant.available %}
                            {% assign is_available = true %}
                          {% endif %}
                        {% endfor %}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %} {% unless is_available %}disabled{% endunless %}>
                          {{ value }}{% unless is_available %} - Out of stock{% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-card__variant-id" />
            <script type="application/json" class="product-variants-json">
              {{ product.variants | json }}
            </script>
          {% else %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
          {% endunless %}
          <button type="submit" class="button button--outlined product-card__quick-add" style="width: 100%;" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            {% render 'icon-cart' %} <span style="margin-left:8px;">{% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          </button>
        </form>
        
        <script>
          if (!window.ProductCardOptionsInitialized) {
            window.ProductCardOptionsInitialized = true;
            
            window.updateProductCard = function(form) {
                var jsonEl = form.querySelector('.product-variants-json');
                if (!jsonEl) return;
                var variants = JSON.parse(jsonEl.textContent);
                var idInput = form.querySelector('.product-card__variant-id');
                var button = form.querySelector('.product-card__quick-add');
                if (!button) return;
                var buttonText = button.querySelector('span') || button;

                // Get all selected options in order
                var optionInputs = form.querySelectorAll('[name^="options["]');
                var selectedInputs = Array.from(optionInputs).filter(function(input) {
                  if (input.tagName === 'SELECT') return true;
                  if (input.tagName === 'INPUT' && input.type === 'radio') return input.checked;
                  return false;
                });
                var options = selectedInputs.map(function(input) { return input.value; });
                
                var matchedVariant = variants.find(function(variant) {
                  return variant.options.every(function(val, index) {
                    return val === options[index];
                  });
                });

                if (matchedVariant) {
                  idInput.value = matchedVariant.id;
                  if (matchedVariant.available) {
                    button.disabled = false;
                    buttonText.innerText = 'Add to cart';
                  } else {
                    button.disabled = true;
                    buttonText.innerText = 'Sold out';
                  }
                } else {
                  button.disabled = true;
                  buttonText.innerText = 'Unavailable';
                }

                // Update select options availability
                var selects = form.querySelectorAll('.product-card__option-select');
                selects.forEach(function(select) {
                  var position = parseInt(select.getAttribute('data-option-position'));
                  var optionElements = select.querySelectorAll('option');
                  optionElements.forEach(function(optEl) {
                    var value = optEl.value;
                    
                    var testOptions = options.slice();
                    testOptions[position] = value;
                    
                    var testVariant = variants.find(function(v) {
                      return v.options.every(function(val, idx) { return val === testOptions[idx]; });
                    });
                    
                    if (testVariant && testVariant.available) {
                      optEl.disabled = false;
                      optEl.innerText = value;
                    } else {
                      optEl.disabled = true;
                      optEl.innerText = value + ' - Out of stock';
                    }
                  });
                });
            };

            document.addEventListener('change', function(e) {
              if (e.target.matches('.product-card__option-select') || e.target.matches('.product-card__option-radio')) {
                var form = e.target.closest('form');
                if (form) window.updateProductCard(form);
              }
            });

            window.updateAllProductCards = function() {
              document.querySelectorAll('.product-card__form').forEach(window.updateProductCard);
            };
            
            document.addEventListener('DOMContentLoaded', window.updateAllProductCards);
            // Fallback if already loaded
            if (document.readyState === 'interactive' || document.readyState === 'complete') {
              setTimeout(window.updateAllProductCards, 100);
            }
          }
        </script>
      {% else %}
        <button class="button button--outlined product-card__quick-add" disabled>
          Sold out
        </button>
      {% endif %}
    </div>
  </div>
</div>
