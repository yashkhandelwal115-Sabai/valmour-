{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>Here's your gift card!</title>
    
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ 'velour.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <div class="gift-card">
      <header class="gift-card__header">
        <h1>{{ shop.name }}</h1>
        <h2>Here's your gift card!</h2>
      </header>

      <main class="gift-card__main">
        <div class="gift-card__image-wrapper">
          <img src="{{ 'gift-card/card.svg' | shopify_asset_url }}" alt="" class="gift-card__image" width="1000" height="1000">
        </div>
        
        <div class="gift-card__info">
          <p>Value: {{ gift_card.initial_value | money }}</p>
          {% if gift_card.balance != gift_card.initial_value %}
            <p>Balance: {{ gift_card.balance | money }}</p>
          {% endif %}
          
          <div class="gift-card__code">
            <input type="text" value="{{ gift_card.code | format_code }}" aria-label="Gift card code" readonly>
          </div>
          
          <div id="qr-code" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
          
          {% if gift_card.pass_url %}
            <a href="{{ gift_card.pass_url }}" class="gift-card__apple-wallet">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet">
            </a>
          {% endif %}
          
          <a href="{{ shop.url }}" class="button" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
            Start shopping
          </a>
        </div>
      </main>
    </div>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var qrCodeContainer = document.getElementById('qr-code');
        if (qrCodeContainer) {
          new QRCode(qrCodeContainer, {
            text: qrCodeContainer.dataset.identifier,
            width: 120,
            height: 120
          });
        }
      });
    </script>
  </body>
</html>
