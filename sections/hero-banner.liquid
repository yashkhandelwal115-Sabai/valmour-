<link rel="preload" href="{{ 'cinematic-hero.css' | asset_url }}" as="style">
{{ 'cinematic-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cinematic-hero.js' | asset_url }}" defer="defer"></script>

<div class="hero cinematic-hero" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
  
  <!-- Background Image Layer -->
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 3840 | image_tag: class: 'cinematic-hero__bg', loading: 'eager', fetchpriority: 'high' }}
  {% else %}
    <img 
      src="{{ 'high_fashion_hero.png' | asset_url }}" 
      class="cinematic-hero__bg" 
      alt="VELOUR – Luxury Fashion"
      width="1920" 
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  {% endif %}

  <!-- Vanilla JS Particle Engine Canvas -->
  <canvas class="cinematic-hero__canvas"></canvas>

  <!-- Typography Content Layer -->
  <div class="cinematic-hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="cinematic-hero__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    
    {% if section.settings.subheading != blank %}
      <p class="cinematic-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}
    
    {% if section.settings.button_label != blank %}
      <div class="cinematic-hero__button-wrapper">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="cinematic-hero__button">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Live Cinematic Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Base Hero Image",
      "info": "This image will be animated using CSS."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 30,
      "unit": "%",
      "label": "Video overlay opacity"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "VELOUR",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "TIMELESS ELEGANCE",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "SHOP COLLECTION",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Live Cinematic Hero"
    }
  ]
}
{% endschema %}
