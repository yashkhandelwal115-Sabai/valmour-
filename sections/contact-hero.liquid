<div class="contact-hero" style="display: flex; flex-wrap: wrap; min-height: 70vh; background: linear-gradient(135deg, #FAF8F5 0%, #F0EAE1 100%); overflow: hidden;">
  <div class="contact-hero__text" style="flex: 1 1 50%; display: flex; flex-direction: column; justify-content: center; padding: 6rem 8%; min-width: 320px;">
    <h1 style="font-family: var(--font-heading-family); font-size: clamp(3.5rem, 6vw, 5.5rem); line-height: 1.1; margin-bottom: 1rem; font-weight: 400; color: var(--color-text);">
      {{ section.settings.heading }}
    </h1>
    <h2 style="font-family: var(--font-body-family); font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 2rem; font-weight: 600;">
      {{ section.settings.subheading }}
    </h2>
    <p style="font-family: var(--font-body-family); font-size: 1.1rem; line-height: 1.6; max-width: 450px; color: var(--color-text); opacity: 0.8;">
      {{ section.settings.text }}
    </p>
  </div>
  
  <div class="contact-hero__image-wrapper" style="flex: 1 1 50%; min-width: 320px; position: relative; min-height: 50vh;">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: style: 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;' }}
    {% else %}
      <img src="https://images.unsplash.com/photo-1581044777550-4cfa60707c03?q=100&w=1600&auto=format&fit=crop" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center;" alt="Contact Us">
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contact Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "WE WOULD LOVE TO HEAR FROM YOU"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our team is here to assist you with any questions about orders, products, styling advice, or general inquiries.\n\nWe aim to respond within 24 hours."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Contact Hero"
    }
  ]
}
{% endschema %}
