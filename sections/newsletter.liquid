<div class="newsletter section-newsletter">
  <div class="newsletter__container reveal-stagger-container">
    {% if section.settings.heading != blank %}
      <h2 class="newsletter__heading reveal-stagger-child">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="newsletter__subheading reveal-stagger-child">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    {% form 'customer', class: 'newsletter__form reveal-stagger-child' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field">
        <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">Email</label>
        <input 
          id="NewsletterEmail-{{ section.id }}"
          type="email" 
          name="contact[email]" 
          class="newsletter__input" 
          value="{{ form.email }}"
          aria-required="true" 
          autocorrect="off" 
          autocapitalize="off" 
          autocomplete="email" 
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="Newsletter-error--{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="Newsletter-success--{{ section.id }}"
          {% endif %}
          placeholder="Email address"
          required
        >
        <button type="submit" class="button newsletter__button" name="commit" id="Subscribe-{{ section.id }}">
          {{ section.settings.button_label | escape }}
        </button>
      </div>
      {%- if form.errors -%}
        <small class="newsletter__message newsletter__message--error" id="Newsletter-error--{{ section.id }}">
          {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
        </small>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <h3 class="newsletter__message newsletter__message--success" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
          Thanks for subscribing
        </h3>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Subscribe to our emails",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "A short sentence describing what someone will receive by subscribing",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Subscribe",
      "label": "Button label"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
