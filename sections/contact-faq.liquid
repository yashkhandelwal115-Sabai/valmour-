<div class="contact-faq" style="background-color: #FAF8F5; padding: 2rem 5% 6rem;">
  <div style="max-width: 1400px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 0; background: #fff; box-shadow: 0 10px 40px rgba(0,0,0,0.04); border-radius: 4px; overflow: hidden;">
    
    <!-- Left Column: Image -->
    <div class="contact-faq__image" style="flex: 1 1 50%; min-width: 320px; position: relative; min-height: 400px;">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: style: 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;' }}
      {% else %}
        <img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?q=80&w=1200&auto=format&fit=crop" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" alt="FAQ Image">
      {% endif %}
    </div>
    
    <!-- Right Column: Accordion -->
    <div class="contact-faq__content" style="flex: 1 1 50%; padding: 5rem 4rem; min-width: 320px;">
      <h3 style="font-family: var(--font-heading-family); font-size: 1.5rem; letter-spacing: 0.1em; margin-bottom: 3rem; text-transform: uppercase;">
        {{ section.settings.heading }}
      </h3>
      
      <style>
        .faq-item {
          border-bottom: 1px solid rgba(0,0,0,0.08);
        }
        .faq-item__btn {
          width: 100%;
          text-align: left;
          background: none;
          border: none;
          padding: 1.5rem 0;
          font-family: var(--font-body-family);
          font-size: 1rem;
          font-weight: 500;
          color: var(--color-text);
          display: flex;
          justify-content: space-between;
          align-items: center;
          cursor: pointer;
        }
        .faq-item__icon {
          transition: transform 0.3s ease;
        }
        .faq-item.active .faq-item__icon {
          transform: rotate(45deg);
        }
        .faq-item__content {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.4s ease, padding 0.4s ease;
          font-size: 0.95rem;
          color: #555;
          line-height: 1.6;
        }
        .faq-item.active .faq-item__content {
          max-height: 200px;
          padding-bottom: 1.5rem;
        }
      </style>
      
      <div class="faq-accordion">
        {% for block in section.blocks %}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <button class="faq-item__btn" onclick="this.parentElement.classList.toggle('active')">
              {{ block.settings.question }}
              <span class="faq-item__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </span>
            </button>
            <div class="faq-item__content">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Contact FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMMON QUESTIONS"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is your question?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Here is the answer to the question." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "What are your shipping times?" } },
        { "type": "faq", "settings": { "question": "What is your return policy?" } },
        { "type": "faq", "settings": { "question": "How do I track my order?" } },
        { "type": "faq", "settings": { "question": "Do you offer international shipping?" } },
        { "type": "faq", "settings": { "question": "Where can I find the size guide?" } }
      ]
    }
  ]
}
{% endschema %}
