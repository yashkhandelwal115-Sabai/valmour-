<div class="collection-hero" style="display: flex; flex-wrap: wrap; min-height: 400px; background: linear-gradient(135deg, #FAF8F5 0%, #F0EAE1 100%); overflow: hidden;">
  <div class="collection-hero__text" style="flex: 1 1 50%; display: flex; flex-direction: column; justify-content: center; padding: 4rem 8%; min-width: 320px;">
    <h1 style="font-family: var(--font-heading-family); font-size: clamp(3rem, 5vw, 4.5rem); line-height: 1.1; margin-bottom: 0.5rem; font-weight: 400; color: var(--color-text);">
      {{ collection.title | default: section.settings.heading }}
    </h1>
    <div style="width: 60px; height: 2px; background: var(--color-accent); margin-bottom: 2rem;"></div>
    <p style="font-family: var(--font-body-family); font-size: 1.1rem; line-height: 1.6; max-width: 450px; color: var(--color-text); opacity: 0.9;">
      {{ collection.description | default: section.settings.text | strip_html }}
    </p>
  </div>
  
  <div class="collection-hero__image-wrapper" style="flex: 1 1 50%; min-width: 320px; position: relative; min-height: 300px;">
    {% if collection.image != blank %}
      {{ collection.image | image_url: width: 1600 | image_tag: style: 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;' }}
    {% elsif section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: style: 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;' }}
    {% else %}
      <img src="{{ 'western_fashion_hero.png' | asset_url }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%;" alt="Collection Hero">
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback Heading",
      "default": "Products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Fallback Text",
      "default": "Timeless pieces. Modern silhouettes. Crafted with intention."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image"
    }
  ],
  "presets": [
    {
      "name": "Collection Hero"
    }
  ]
}
{% endschema %}
