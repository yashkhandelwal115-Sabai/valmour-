<div class="cart-page" style="background-color: #FAF8F5; padding: 4rem 5% 8rem;">
  <div style="max-width: 1400px; margin: 0 auto;">
    
        {% if cart.empty? %}
      <div style="text-align: center; padding: 4rem 0;">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #000)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 2rem;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <h2 style="font-family: var(--font-heading-family); font-size: 2rem; margin-bottom: 1rem;">Your cart is empty</h2>
        <p style="color: #666; margin-bottom: 2rem;">Looks like you haven't added anything to your cart yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="button" style="background-color: var(--color-accent); color: #fff; padding: 1rem 2rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.8rem;">
          CONTINUE SHOPPING
        </a>
      </div>
    {% else %}
      <header class="cart-header" style="margin-bottom: 3rem;">
        <h1 style="font-family: var(--font-heading-family); font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 400; letter-spacing: 0.05em; color: var(--color-text); margin-bottom: 1rem; text-transform: uppercase;">
          Your Cart ({{ cart.item_count }})
        </h1>
        
        <!-- Progress Bar -->
        <div class="shipping-progress" style="margin-bottom: 1rem;">
          {% assign threshold = 20000 %}
          {% assign total = cart.total_price %}
          {% assign away = threshold | minus: total %}
          {% assign percent = total | times: 100.0 | divided_by: threshold %}
          {% if percent > 100 %}{% assign percent = 100 %}{% endif %}
          
          <p style="font-size: 0.9rem; color: var(--color-text); margin-bottom: 0.5rem; display: flex; justify-content: space-between;">
            {% if percent >= 100 %}
              <span>You have unlocked free shipping!</span>
            {% else %}
              <span>You're <strong>{{ away | money }}</strong> away from free shipping!</span>
            {% endif %}
            <span style="color: #666;">$200</span>
          </p>
          <div style="width: 100%; height: 4px; background: #E5E0D8; border-radius: 2px; overflow: hidden;">
            <div style="width: {{ percent }}%; height: 100%; background: var(--color-accent); border-radius: 2px;"></div>
          </div>
        </div>
      </header>

      <div class="cart-layout" style="display: flex; flex-wrap: wrap; gap: 4rem; align-items: flex-start;">
        <!-- Left Column: Cart Items -->
        <div class="cart-items__col" style="flex: 2 1 600px;">
          <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart__contents critical-hidden">
            
<style>
  /* Base Desktop Styles */
  .cart-table__header {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 1fr;
    column-gap: 2rem;
    border-bottom: 1px solid #E5E0D8;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #666;
    font-weight: 600;
  }
  
  .cart-item {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 1fr;
    column-gap: 2rem;
    align-items: center;
    border-bottom: 1px solid #E5E0D8;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }
  
  .cart-item__info {
    display: flex;
    gap: 1.5rem;
  }
  
  .cart-item__image {
    width: 120px;
    height: 150px;
    object-fit: cover;
  }
  
  .cart-item__details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .cart-item__title {
    font-family: var(--font-heading-family);
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }
  .cart-item__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .cart-item__variant {
    font-size: 0.8rem;
    color: #666;
    margin-bottom: 0.5rem;
  }
  
  .cart-item__description {
    font-size: 0.75rem;
    color: #555;
    line-height: 1.4;
    max-width: 200px;
    margin-bottom: 1rem;
  }
  
  .cart-item__remove {
    font-size: 0.75rem;
    text-decoration: underline;
    color: #666;
  }
  .cart-item__remove a {
    color: inherit;
  }
  
  .cart-item__price--desktop,
  .cart-item__total--desktop {
    text-align: right;
    font-size: 0.9rem;
  }
  
  .cart-item__price--mobile,
  .cart-item__remove--mobile {
    display: none;
  }
  
  .cart-item__quantity {
    display: flex;
    justify-content: center;
  }
  
  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #E5E0D8;
    padding: 0.5rem 1rem;
    gap: 1rem;
    background: #fff;
  }
  .quantity-selector button {
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0 0.5rem;
  }
  .quantity-selector input {
    font-size: 0.9rem;
    width: 40px;
    text-align: center;
    border: none;
    background: transparent;
    -moz-appearance: textfield;
  }
  .quantity-selector input::-webkit-outer-spin-button,
  .quantity-selector input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .cart-table__header {
      display: none !important;
    }
    
    .cart-item {
      display: flex;
      flex-direction: column;
      background: #fff;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 20px;
      border-bottom: none;
      align-items: stretch;
    }
    
    .cart-item__info {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
    }
    
    .cart-item__image {
      width: 90px;
      height: 120px;
      flex-shrink: 0;
    }
    
    .cart-item__details {
      flex: 1;
      min-width: 0;
    }
    
    .cart-item__title {
      font-size: 1rem;
      word-break: break-word;
    }
    
    .cart-item__price--desktop,
    .cart-item__total--desktop,
    .cart-item__remove--desktop,
    .cart-item__description {
      display: none;
    }
    
    .cart-item__price--mobile {
      display: block;
      font-weight: 600;
      margin-top: 10px;
      font-size: 0.95rem;
    }
    
    .cart-item__quantity {
      width: 100%;
      margin-top: 12px;
      display: block;
    }
    
    .quantity-selector {
      width: 100%;
      justify-content: space-between;
    }
    
    .cart-item__remove--mobile {
      display: block;
      margin-top: 12px;
      text-align: center;
    }
  }
</style>

            <div class="cart-table__header">
              <div>Product</div>
              <div style="text-align: right;">Price</div>
              <div style="text-align: center;">Quantity</div>
              <div style="text-align: right;">Total</div>
            </div>
            
            {% for item in cart.items %}
              <div class="cart-item">
                <div class="cart-item__info">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 300 }}" class="cart-item__image" alt="{{ item.title | escape }}">
                  {% endif %}
                  <div class="cart-item__details">
                    <h3 class="cart-item__title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h3>
                    {% unless item.product.has_only_default_variant %}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {% endunless %}
                    
                    {%- if item.selling_plan_allocation != null -%}
                      <p class="cart-item__selling-plan" style="font-size: 0.75rem; color: var(--color-accent); margin-bottom: 0.5rem; font-style: italic;">
                        {{ item.selling_plan_allocation.selling_plan.name }}
                      </p>
                    {%- endif -%}
                    
                    <p class="cart-item__description">{{ item.product.description | strip_html | truncatewords: 10 }}</p>
                    
                    <div class="cart-item__price--mobile">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s style="color: #999; font-size: 0.8em; margin-right: 5px;">{{ item.original_line_price | money }}</s>
                        <span style="color: var(--color-accent);">{{ item.final_line_price | money }}</span>
                      {%- else -%}
                        {{ item.original_line_price | money }}
                      {%- endif -%}
                      
                      {%- if item.variant.unit_price_measurement -%}
                        <div class="unit-price" style="font-size: 0.75rem; color: #666; margin-top: 4px;">
                          {{ item.variant.unit_price | money }} / 
                          {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                            {{- item.variant.unit_price_measurement.reference_value -}}
                          {%- endif -%}
                          {{ item.variant.unit_price_measurement.reference_unit }}
                        </div>
                      {%- endif -%}
                    </div>
                    
                    <div class="cart-item__remove cart-item__remove--desktop">
                      <a href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                </div>
                
                <div class="cart-item__price--desktop">
                  {%- if item.original_price != item.final_price -%}
                    <div style="display: flex; flex-direction: column; align-items: flex-end;">
                      <s style="color: #999; font-size: 0.8em;">{{ item.original_price | money }}</s>
                      <span style="color: var(--color-accent);">{{ item.final_price | money }}</span>
                    </div>
                  {%- else -%}
                    {{ item.original_price | money }}
                  {%- endif -%}
                  
                  {%- if item.variant.unit_price_measurement -%}
                    <div class="unit-price" style="font-size: 0.75rem; color: #666; margin-top: 4px;">
                      {{ item.variant.unit_price | money }} / 
                      {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                        {{- item.variant.unit_price_measurement.reference_value -}}
                      {%- endif -%}
                      {{ item.variant.unit_price_measurement.reference_unit }}
                    </div>
                  {%- endif -%}
                </div>
                
                <div class="cart-item__quantity">
                  <div class="quantity-selector">
                    <button type="button" class="qty-minus">-</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                    <button type="button" class="qty-plus">+</button>
                  </div>
                </div>
                
                <div class="cart-item__total--desktop">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <div style="display: flex; flex-direction: column; align-items: flex-end;">
                      <s style="color: #999; font-size: 0.8em;">{{ item.original_line_price | money }}</s>
                      <span style="color: var(--color-accent);">{{ item.final_line_price | money }}</span>
                    </div>
                  {%- else -%}
                    {{ item.original_line_price | money }}
                  {%- endif -%}
                  
                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul style="list-style: none; padding: 0; margin: 5px 0 0; font-size: 0.75rem; color: var(--color-accent); text-align: right;">
                      {%- for discount in item.line_level_discount_allocations -%}
                        <li style="display: flex; align-items: center; justify-content: flex-end; gap: 4px;">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                          {{ discount.discount_application.title }} (-{{ discount.amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
                
                <div class="cart-item__remove cart-item__remove--mobile">
                  <a href="{{ item.url_to_remove }}">Remove</a>
                </div>
              </div>
            {% endfor %}
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
              <a href="{{ routes.all_products_collection_url }}" class="button button--outlined" style="background: transparent; color: var(--color-text); border: 1px solid #ccc; padding: 1rem 2rem; font-size: 0.75rem; letter-spacing: 0.1em; display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                CONTINUE SHOPPING
              </a>
              <!-- Removed UPDATE CART button -->
            </div>
            
            {%- if settings.show_cart_note -%}
              <div class="cart__note" style="margin-top: 3rem;">
                <label for="Cart-note" style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">Order Special Instructions</label>
                <textarea class="text-area text-area--resize-vertical" name="note" id="Cart-note" placeholder="Add a note to your order..." style="width: 100%; min-height: 100px; padding: 1rem; border: 1px solid #E5E0D8; font-family: var(--font-body-family); font-size: 0.9rem; resize: vertical;">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
            
          </form>
          
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              var cartForm = document.getElementById('cart');
              var qtyInputs = cartForm.querySelectorAll('.quantity-selector input');
              var timeout;

              function submitForm() {
                cartForm.style.opacity = '0.5';
                cartForm.style.pointerEvents = 'none';
                cartForm.submit();
              }

              function debounceSubmit() {
                clearTimeout(timeout);
                timeout = setTimeout(submitForm, 600);
              }

              qtyInputs.forEach(function(input) {
                input.addEventListener('change', debounceSubmit);
              });

              var minusBtns = cartForm.querySelectorAll('.qty-minus');
              var plusBtns = cartForm.querySelectorAll('.qty-plus');

              minusBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                  var input = this.nextElementSibling;
                  var val = parseInt(input.value) || 0;
                  if (val > 0) {
                    input.value = val - 1;
                    debounceSubmit();
                  }
                });
              });

              plusBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                  var input = this.previousElementSibling;
                  var val = parseInt(input.value) || 0;
                  input.value = val + 1;
                  debounceSubmit();
                });
              });
            });
          </script>
        </div>
        
        <!-- Right Column: Sticky Summary -->
        <div class="cart-summary__col" style="flex: 1 1 350px; position: sticky; top: 2rem;">
          <div class="cart-summary__box" style="background: #FAF8F5; border: 1px solid #E5E0D8; padding: 2.5rem;">
            <h3 style="font-family: var(--font-heading-family); font-size: 1.1rem; letter-spacing: 0.1em; margin-bottom: 2rem; text-transform: uppercase;">
              ORDER SUMMARY
              <div style="width: 30px; height: 1px; background: var(--color-accent); margin-top: 1rem;"></div>
            </h3>
            
            <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; font-size: 0.9rem;">
              <span style="color: #666;">Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            
            <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem; font-size: 0.9rem;">
              <span style="color: #666; display: flex; align-items: center; gap: 0.5rem;">Shipping <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></span>
              <span style="color: #666;">Calculated at checkout</span>
            </div>
            
            <div style="display: flex; justify-content: space-between; margin-bottom: 2rem; font-size: 0.9rem;">
              <span style="color: #666; display: flex; align-items: center; gap: 0.5rem;">Estimated taxes <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></span>
              <span>{{ cart.total_price | times: 0.08 | money }}</span>
            </div>
            
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <div style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #E5E0D8;">
                <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); margin-bottom: 1rem;">Discounts Applied</h4>
                <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: var(--color-accent);">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <li style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                      <span style="display: flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        {{ discount.title }}
                      </span>
                      <span>-{{ discount.total_allocated_amount | money }}</span>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; border-top: 1px solid #E5E0D8; padding-top: 2rem;">
              <span style="font-size: 1.2rem; font-family: var(--font-heading-family);">Total</span>
              <div>
                <span style="font-size: 1.5rem; font-weight: 600;">{{ cart.total_price | money }}</span>
                <span style="font-size: 0.7rem; color: #666; margin-left: 0.25rem;">USD</span>
              </div>
            </div>
            
            <p style="font-size: 0.75rem; color: #666; margin-bottom: 2rem; line-height: 1.5;">
              or 4 interest-free payments of <strong>{{ cart.total_price | times: 1.08 | divided_by: 4 | money }}</strong> with <span style="color: #5A31F4; font-weight: bold;">shop<span style="background: #5A31F4; color: #fff; padding: 0 2px; border-radius: 2px;">Pay</span></span> <a href="#" style="text-decoration: underline; color: inherit;">Learn more</a>
            </p>
            
            <button type="submit" name="checkout" form="cart" class="button" style="width: 100%; background-color: var(--color-accent); color: #fff; border: none; padding: 1.25rem; font-size: 0.8rem; letter-spacing: 0.15em; display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 1rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              CHECKOUT
            </button>
            
            {%- if additional_checkout_buttons -%}
              <div class="cart__dynamic-checkout-buttons additional-checkout-buttons" style="margin-top: 1rem;">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {%- endif -%}
            

            
          </div>
        </div>
      </div>
    {% endif %}  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
