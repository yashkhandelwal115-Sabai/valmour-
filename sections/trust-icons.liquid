<div class="trust-icons" style="padding: var(--spacing-section) 5%; background-color: var(--color-surface); border-top: 1px solid rgba(0,0,0,0.05); text-align: center;">
  <div class="page-width grid grid-4" style="align-items: flex-start;">
    {% for block in section.blocks %}
      <div class="trust-icons__item" style="display: flex; gap: 1rem; text-align: left; align-items: flex-start;" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <div class="trust-icons__icon-wrapper" style="flex: 0 0 32px;">
             {{ block.settings.icon }}
          </div>
        {% else %}
          <div class="trust-icons__icon-wrapper" style="flex: 0 0 32px; height: 32px; background: #eee; border-radius: 50%;"></div>
        {% endif %}
        
        <div class="trust-icons__content">
          <h4 class="trust-icons__heading" style="font-family: var(--font-body-family); font-weight: 600; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.1em; margin-bottom: 0.5rem;">{{ block.settings.heading }}</h4>
          <p class="trust-icons__text" style="font-size:0.75rem; color:var(--color-muted); line-height: 1.4; margin: 0;">{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Icons",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon Block",
      "settings": [
        { "type": "html", "id": "icon", "label": "SVG Icon HTML" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free Shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "On all orders over $200" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Icons",
      "blocks": [
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" }
      ]
    }
  ]
}
{% endschema %}
