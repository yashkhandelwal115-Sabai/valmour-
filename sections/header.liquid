<header class="header {% if section.settings.enable_sticky %}header--sticky{% endif %} {% if template.name == 'index' and template.suffix == blank and section.settings.transparent_on_home %}header--transparent{% endif %}">
  <div class="header__container">
    {% if section.settings.logo != blank %}
      <a href="{{ routes.root_url }}" class="header__logo">
        <img src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}" 
             alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
             width="{{ section.settings.logo_width }}"
             height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}"
             loading="lazy">
      </a>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo header__logo--text">VELOUR</a>
    {% endif %}

    <nav class="header__nav" aria-label="Main Navigation" data-mobile-nav>
      <div class="mobile-nav-header">
        <button class="mobile-nav-close" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <ul class="header__menu">
        {% for link in section.settings.menu.links %}
          <li class="header__menu-item {% if link.links != blank %}has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title | escape }}
            </a>
            {% if link.links != blank %}
              <ul class="header__submenu">
                {% for childlink in link.links %}
                  <li class="header__submenu-item">
                    <a href="{{ childlink.url }}" class="header__submenu-link" {% if childlink.current %}aria-current="page"{% endif %}>
                      {{ childlink.title | escape }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
        <li class="header__menu-item">
          <a href="/?view=our-story" class="header__menu-link">About Us</a>
        </li>
      </ul>
    </nav>
    <div class="mobile-nav-overlay"></div>

    <div class="header__icons">
      <button type="button" class="header__icon" data-search-drawer-toggle aria-label="Search">
        {% render 'icon-search' %}
      </button>

      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__icon" aria-label="Account">
        {% render 'icon-account' %}
      </a>

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}">
        {% render 'icon-cart' %}
        <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
      </a>
      
      <button class="header__hamburger" data-mobile-nav-toggle aria-expanded="false" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon-hamburger' %}
      </button>
    </div>
  </div>
</header>

<div class="search-drawer" id="SearchDrawer">
  <div class="search-drawer__container">
    <button class="search-drawer__close" aria-label="Close search">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <predictive-search>
      <form action="{{ routes.search_url }}" method="get" class="search-drawer__form" role="search">
        <input 
          class="search-drawer__input"
          type="search" 
          name="q" 
          placeholder="Search collections, products..." 
          aria-label="Search"
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results-list"
          aria-controls="predictive-search-results-list"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="header__icon" style="padding: 0.5rem; display: flex; align-items: center; justify-content: center;">{% render 'icon-search' %}</button>
      </form>
      <div class="predictive-search" tabindex="-1" data-predictive-search></div>
    </predictive-search>
  </div>
</div>
<div class="search-drawer-overlay"></div>

{{ 'predictive-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "default": true,
      "label": "Enable sticky header"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "default": false,
      "label": "Enable transparent header on homepage"
    }
  ]
}
{% endschema %}
