<div class="wishlist-page" style="max-width: 1600px; margin: 0 auto; padding: 4rem 5%;">
  <h1 style="font-family: var(--font-heading-family); font-size: 2rem; text-transform: uppercase; letter-spacing: 0.1em; text-align: center; margin-bottom: 3rem;">Your Wishlist</h1>
  
  <div id="wishlist-loader" style="text-align: center; padding: 4rem 0;">
    <p>Loading your wishlist...</p>
  </div>
  
  <div id="wishlist-empty" style="display: none; text-align: center; padding: 4rem 0;">
    <p style="font-size: 1.1rem; color: #666; margin-bottom: 2rem;">Your wishlist is currently empty.</p>
    <a href="{{ routes.collections_url }}/all" class="button" style="background-color: var(--color-accent); color: #fff; padding: 1rem 2rem; text-decoration: none; display: inline-block; border: none; cursor: pointer; text-transform: uppercase; letter-spacing: 0.1em;">Continue Shopping</a>
  </div>

  <div id="wishlist-grid" class="grid-4-special" style="display: none;"></div>
</div>

<style>
  .grid-4-special {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }
  @media (min-width: 600px) {
    .grid-4-special { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .grid-4-special { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wishlist = JSON.parse(localStorage.getItem('velour_wishlist')) || [];
    const loader = document.getElementById('wishlist-loader');
    const emptyState = document.getElementById('wishlist-empty');
    const grid = document.getElementById('wishlist-grid');

    if (wishlist.length === 0) {
      loader.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    let loadedCount = 0;
    grid.style.display = 'grid';

    wishlist.forEach(handle => {
      // Demo products start with demo-product-
      if (handle.startsWith('demo-product-')) {
          loadedCount++;
          if (loadedCount === wishlist.length) {
            loader.style.display = 'none';
            if (window.initWishlist) window.initWishlist();
          }
          return;
      }

      fetch('/products/' + handle + '?view=card')
        .then(response => {
          if (!response.ok) throw new Error('Product not found');
          return response.text();
        })
        .then(html => {
          const div = document.createElement('div');
          div.className = 'filterable-product';
          div.innerHTML = html;
          grid.appendChild(div);
        })
        .catch(err => console.error('Failed to load product:', handle, err))
        .finally(() => {
          loadedCount++;
          if (loadedCount === wishlist.length) {
            loader.style.display = 'none';
            if (window.initWishlist) window.initWishlist();
          }
        });
    });
  });
</script>

{% schema %}
{
  "name": "Wishlist",
  "settings": []
}
{% endschema %}
