<div class="collection-list" style="padding: 2rem 0 4rem; overflow: hidden; width: 100%;">
  <style>
    .collection-card:hover img { transform: scale(1.05); }
    .collection-card__overlay span { position: relative; }
    .collection-card__overlay span::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 100%; height: 1px; background: #fff; transform: scaleX(0); transform-origin: right; transition: transform 0.4s ease; }
    .collection-card:hover .collection-card__overlay span::after { transform: scaleX(1); transform-origin: left; }
    
    @keyframes collectionMarquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); } 
    }
    .collection-list__track {
      display: flex;
      width: max-content;
      animation: collectionMarquee 25s linear infinite;
    }
    .collection-list__track:hover {
      animation-play-state: paused;
    }
    .collection-list__item {
      width: 25vw;
      flex-shrink: 0;
      padding: 0 0.75rem; /* Creates a 1.5rem gap between items without breaking the 50% translation math */
    }
    @media (max-width: 768px) {
      .collection-list__item {
        width: 65vw; /* Show 1.5 cards on mobile */
      }
    }
  </style>

  <div class="collection-list__track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="collection-list__item">
          <div class="collection-card" style="position: relative; display: block; overflow: hidden; aspect-ratio: 4/5;" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(max-width: 768px) 65vw, 25vw', style: 'width: 100%; height: 100%; object-fit: cover; transition: transform 1.5s cubic-bezier(0.19, 1, 0.22, 1);' }}
            {% else %}
              {% assign fallback_img = 'https://images.unsplash.com/photo-1591561954557-26941169b49e?q=80&w=800&auto=format&fit=crop' %}
              {% if block.settings.title == 'WOMEN' or block.settings.title == 'Women' %}
                {% assign fallback_img = 'https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=800&auto=format&fit=crop' %}
              {% elsif block.settings.title == 'MEN' or block.settings.title == 'Men' %}
                {% assign fallback_img = 'https://images.unsplash.com/photo-1617137968427-85924c800a22?q=80&w=800&auto=format&fit=crop' %}
              {% elsif block.settings.title == 'THE COLLECTION' or block.settings.title == 'The Collection' %}
                {% assign fallback_img = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=800&auto=format&fit=crop' %}
              {% endif %}
              <img src="{{ fallback_img }}" srcset="{{ fallback_img | replace: 'w=800', 'w=400' }} 400w, {{ fallback_img | replace: 'w=800', 'w=600' }} 600w, {{ fallback_img }} 800w" sizes="(max-width: 768px) 65vw, 25vw" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 1.5s cubic-bezier(0.19, 1, 0.22, 1);" alt="{{ block.settings.title }}">
            {% endif %}
            <div class="collection-card__overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.25); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #FFF; transition: background 0.4s ease;">
              <h3 style="font-family: var(--font-heading-family); font-size: 1.75rem; letter-spacing: 0.15em; margin-bottom: 0.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.2);">{{ block.settings.title }}</h3>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection List",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Women" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        { "type": "collection", "settings": { "title": "Women" } },
        { "type": "collection", "settings": { "title": "Men" } },
        { "type": "collection", "settings": { "title": "The Collection" } },
        { "type": "collection", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
