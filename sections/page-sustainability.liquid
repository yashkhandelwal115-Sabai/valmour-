<div class="page-width" style="max-width: 1200px; margin: 0 auto; padding: 4rem 5%;">
  <div style="text-align: center; margin-bottom: 4rem;">
    <h1 style="font-family: var(--font-heading-family); font-size: 3rem; margin-bottom: 1.5rem; text-transform: uppercase;">Sustainability</h1>
    <p style="color: #666; max-width: 600px; margin: 0 auto; line-height: 1.8;">We are committed to reducing our environmental impact and promoting ethical practices throughout our entire supply chain.</p>
  </div>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; margin-bottom: 4rem;">
    <div style="text-align: center;">
      <img src="https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?q=80&w=600&auto=format&fit=crop" alt="Eco friendly" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px; margin-bottom: 1.5rem;">
      <h3 style="font-family: var(--font-heading-family); font-size: 1.5rem; margin-bottom: 1rem;">Ethical Sourcing</h3>
      <p style="color: #666; line-height: 1.6;">We partner exclusively with suppliers who provide fair wages and safe working conditions. Our fabrics are sourced responsibly with full traceability.</p>
    </div>
    <div style="text-align: center;">
      <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?q=80&w=600&auto=format&fit=crop" alt="Organic fabrics" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px; margin-bottom: 1.5rem;">
      <h3 style="font-family: var(--font-heading-family); font-size: 1.5rem; margin-bottom: 1rem;">Organic Materials</h3>
      <p style="color: #666; line-height: 1.6;">Over 80% of our collections are made from organic cotton, recycled polyester, and sustainable TENCEL™ lyocell fibers.</p>
    </div>
    <div style="text-align: center;">
      <img src="https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?q=80&w=600&auto=format&fit=crop" alt="Recycling packaging" style="width: 100%; height: 250px; object-fit: cover; border-radius: 4px; margin-bottom: 1.5rem;">
      <h3 style="font-family: var(--font-heading-family); font-size: 1.5rem; margin-bottom: 1rem;">Zero Waste Packaging</h3>
      <p style="color: #666; line-height: 1.6;">All our packaging is 100% recyclable and made from post-consumer waste. We have eliminated single-use plastics from our shipments.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sustainability",
  "settings": []
}
{% endschema %}
