<article class="article-page">
  <h1>{{ article.title }}</h1>
  <p>{{ article.published_at | time_tag: format: 'date' }}</p>
  <div class="article-page__content">
    {{ article.content }}
  </div>

  {% if blog.comments_enabled? %}
    <div class="article-page__comments">
      <h2>Comments</h2>
      {% paginate article.comments by 5 %}
        {% for comment in article.comments %}
          <div class="comment">
            <p>{{ comment.content }}</p>
            <p>- {{ comment.author }}</p>
          </div>
        {% endfor %}
        {{ paginate | default_pagination }}
      {% endpaginate %}

      {% form 'new_comment', article %}
        {% if form.posted_successfully? %}
          <p>Comment posted successfully!</p>
        {% elsif form.errors %}
          <div class="form-errors" style="color: red; margin-bottom: 1rem;">
            <p>Error posting comment:</p>
            <ul>
              {% for error in form.errors %}
                <li>{{ error }} - {{ form.errors.messages[error] }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        <label for="CommentAuthor">Name</label>
        <input type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}">
        <label for="CommentEmail">Email</label>
        <input type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}">
        <label for="CommentBody">Message</label>
        <textarea name="comment[body]" id="CommentBody">{{ form.body }}</textarea>
        <button type="submit" class="button">Post comment</button>
      {% endform %}
    </div>
  {% endif %}
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
