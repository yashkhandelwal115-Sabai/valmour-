<div style="background-color: #FAF8F5; padding: 4rem 0; min-height: 80vh;">
  <div class="page-width" style="max-width: 1440px; margin: 0 auto; padding: 0 5%;">
    <div style="text-align: center; margin-bottom: 4rem;">
      <h1 style="font-family: var(--font-heading-family); font-size: 3rem; margin-bottom: 1.5rem; text-transform: uppercase;">New Arrivals</h1>
      <p style="color: #666; line-height: 1.8; max-width: 600px; margin: 0 auto;">Discover our latest pieces. Fresh styles added weekly to keep your wardrobe updated with timeless, modern fashion.</p>
    </div>

    <style>
      .grid-4-special {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }
      @media screen and (max-width: 990px) {
        .grid-4-special {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media screen and (max-width: 750px) {
        .grid-4-special {
          grid-template-columns: repeat(1, 1fr);
        }
      }
    </style>

    <div class="grid-4-special">
      {% assign count = 0 %}
      {% if collections.all.products.size > 0 %}
        {% for product in collections.all.products reversed %}
          {% if count < 8 %}
            {% render 'product-card', product: product %}
            {% assign count = count | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- Demo Products -->
        <div class="demo-product" data-category="women">{% render 'product-card', fallback_index: 3 %}</div>
        <div class="demo-product" data-category="men">{% render 'product-card', fallback_index: 4 %}</div>
        <div class="demo-product" data-category="women">{% render 'product-card', fallback_index: 5 %}</div>
        <div class="demo-product" data-category="men">{% render 'product-card', fallback_index: 2 %}</div>
        <div class="demo-product" data-category="men">{% render 'product-card', fallback_index: 1 %}</div>
        <div class="demo-product" data-category="women">{% render 'product-card', fallback_index: 6 %}</div>
        <div class="demo-product" data-category="women">{% render 'product-card', fallback_index: 7 %}</div>
        <div class="demo-product" data-category="men">{% render 'product-card', fallback_index: 8 %}</div>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "New Arrivals",
  "settings": []
}
{% endschema %}
