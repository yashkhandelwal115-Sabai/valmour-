<style>
  .editorial-quote-section {
    background-color: #0B0B0B;
    position: relative;
    overflow: hidden;
    width: 90%;
    max-width: 1300px;
    margin: 4rem auto;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1), transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .editorial-quote-section.reveal-active {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (min-width: 769px) {
    .editorial-quote-section {
      flex-direction: row;
      height: clamp(400px, 35vw, 500px);
      margin: var(--spacing-section) auto;
    }
  }

  /* Left Side: 40% */
  .editorial-quote__left {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
  }
  @media screen and (min-width: 769px) {
    .editorial-quote__left {
      width: 40%;
      height: 100%;
    }
  }
  .editorial-quote__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    display: block;
  }
  .editorial-quote__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at center, rgba(212, 175, 55, 0.15) 0%, rgba(0, 0, 0, 0.4) 100%);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  /* Right Side: 60% */
  .editorial-quote__right {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    box-sizing: border-box;
    z-index: 2;
  }
  @media screen and (min-width: 769px) {
    .editorial-quote__right {
      width: 60%;
      height: 100%;
      padding: 4rem;
    }
  }

  /* Content Inner */
  .editorial-quote__content {
    max-width: 650px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 3;
  }

  /* Subtle floating gold particles canvas */
  .editorial-quote__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Divider line */
  .editorial-quote__divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, transparent, #D4AF37 50%, transparent);
    margin: 1rem 0;
  }

  /* Quote Typography */
  .editorial-quote__text {
    font-family: 'Cormorant Garamond', var(--font-heading-family), serif;
    font-size: clamp(1.5rem, 3.2vw, 3rem);
    font-weight: 300;
    color: #F5F1E8;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
    text-shadow: 0 0 10px rgba(245, 241, 232, 0.15);
  }
  
  .editorial-quote__text span {
    color: #D4AF37;
  }

  /* Author Typography */
  .editorial-quote__author {
    font-family: var(--font-body-family), sans-serif;
    font-size: clamp(0.7rem, 1.2vw, 0.8rem);
    font-weight: 500;
    letter-spacing: 0.25em;
    color: #D4AF37;
    margin-top: 1rem;
    text-transform: uppercase;
  }

  /* Glow element */
  .editorial-quote__glow {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    filter: blur(20px);
  }
</style>

<div class="editorial-quote-section" id="EditorialQuote-{{ section.id }}">
  <!-- Left Side: Image -->
  <div class="editorial-quote__left">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1500 | image_tag: class: 'editorial-quote__image', loading: 'lazy' }}
    {% else %}
      <img src="{{ 'editorial-quote-fashion.png' | asset_url }}" class="editorial-quote__image" loading="lazy" alt="Velour Luxury Editorial">
    {% endif %}
    <div class="editorial-quote__overlay"></div>
  </div>

  <!-- Right Side: Quote -->
  <div class="editorial-quote__right">
    <!-- Glow Background -->
    <div class="editorial-quote__glow"></div>
    
    <!-- Canvas for Floating Gold Particles -->
    <canvas class="editorial-quote__canvas" id="EditorialQuoteCanvas-{{ section.id }}"></canvas>

    <div class="editorial-quote__content">
      <div class="editorial-quote__divider"></div>
      <blockquote style="margin: 0;">
        <p class="editorial-quote__text">
          {{ section.settings.quote_text_1 | default: 'Elegance is not a trend.' }}<br>
          <span>{{ section.settings.quote_text_2 | default: 'It is a signature.' }}</span>
        </p>
      </blockquote>
      <div class="editorial-quote__divider"></div>
      <cite class="editorial-quote__author">— {{ section.settings.author | default: 'VELOUR' }}</cite>
    </div>
  </div>
</div>

<script>
  (function() {
    function initEditorialQuote() {
      const section = document.getElementById('EditorialQuote-{{ section.id }}');
      if (!section) return;

      // 1. Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            section.classList.add('reveal-active');
            observer.unobserve(section);
          }
        });
      }, {
        threshold: 0.1
      });
      observer.observe(section);
      
      // Fallback reveal
      setTimeout(() => {
        section.classList.add('reveal-active');
      }, 600);

      // 2. Gold floating particles canvas animation
      const canvas = document.getElementById('EditorialQuoteCanvas-{{ section.id }}');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      let animationFrameId;

      function resizeCanvas() {
        const rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      const particles = [];
      const particleCount = 20;

      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          radius: Math.random() * 1.5 + 0.5,
          speedY: -(Math.random() * 0.4 + 0.1),
          speedX: Math.random() * 0.2 - 0.1,
          opacity: Math.random() * 0.5 + 0.2
        });
      }

      function drawParticles() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        particles.forEach(p => {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(212, 175, 55, ${p.opacity})`;
          ctx.fill();

          p.y += p.speedY;
          p.x += p.speedX;

          if (p.y < 0) {
            p.y = canvas.height;
            p.x = Math.random() * canvas.width;
          }
          if (p.x < 0 || p.x > canvas.width) {
            p.x = Math.random() * canvas.width;
          }
        });

        animationFrameId = requestAnimationFrame(drawParticles);
      }
      drawParticles();

      // Clean up animation on section unload (theme editor)
      document.addEventListener('shopify:section:unload', function(e) {
        if (e.detail.sectionId === '{{ section.id }}') {
          cancelAnimationFrame(animationFrameId);
          window.removeEventListener('resize', resizeCanvas);
        }
      });
    }

    if (document.readyState !== 'loading') {
      initEditorialQuote();
    } else {
      document.addEventListener('DOMContentLoaded', initEditorialQuote);
    }
  })();
</script>

{% schema %}
{
  "name": "Editorial Quote",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "quote_text_1",
      "label": "Quote Line 1",
      "default": "Elegance is not a trend."
    },
    {
      "type": "text",
      "id": "quote_text_2",
      "label": "Quote Line 2",
      "default": "It is a signature."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "VELOUR"
    }
  ],
  "presets": [
    {
      "name": "Editorial Quote"
    }
  ]
}
{% endschema %}
