<div class="featured-product">
  {%- assign product = all_products[section.settings.product] -%}
  
  <div class="featured-product__container grid grid-2">
    <div class="featured-product__media">
      {% if product != blank and product.media.size > 0 %}
        {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--product' }}
      {% endif %}
    </div>

    <div class="featured-product__info">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@app' %}
            {% render block %}
            
          {% when 'title' %}
            <h2 class="featured-product__title" {{ block.shopify_attributes }} style="font-family: var(--font-heading-family); font-size: 1.8rem; margin-bottom: 0.5rem; text-transform: uppercase;">
              {% if product != blank %}{{ product.title }}{% else %}Example Product Title{% endif %}
            </h2>
            
          {% when 'price' %}
            <div class="featured-product__price" {{ block.shopify_attributes }} style="font-size: 1.2rem; margin-bottom: 1.5rem;">
              {% if product != blank %}
                {% render 'price', product: product %}
              {% else %}
                $19.99
              {% endif %}
            </div>
            
          {% when 'vendor' %}
            <div class="featured-product__vendor" {{ block.shopify_attributes }} style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-muted); margin-bottom: 1rem; letter-spacing: 0.1em;">
              {% if product != blank %}{{ product.vendor }}{% else %}Vendor Name{% endif %}
            </div>
            
          {% when 'description' %}
            <div class="featured-product__description" {{ block.shopify_attributes }} style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem; color: #555;">
              {% if product != blank %}{{ product.description }}{% else %}Product description placeholder.{% endif %}
            </div>

          {% when 'variant_picker' %}
            {% if product != blank and product.has_only_default_variant == false %}
              <div class="product-form__variants" {{ block.shopify_attributes }} style="margin-bottom: 2rem;">
                {% for option in product.options_with_values %}
                  <div class="product-form__option" style="margin-bottom: 1.5rem;">
                    <label class="product-form__option-name" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; display: block; margin-bottom: 0.5rem; font-weight: 600;">{{ option.name }}</label>
                    <select class="featured-product-option-select" name="options[{{ option.name | escape }}]" form="featured-product-form-{{ section.id }}" style="padding: 0.75rem 2rem 0.75rem 1rem; border: 1px solid #e5e0d8; font-family: var(--font-body-family); font-size: 0.85rem; color: var(--color-text); background: #fff; min-width: 180px; appearance: auto; cursor: pointer;">
                      {% for value in option.values %}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                          {{ value }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

          {% when 'buy_buttons' %}
            {% if product != blank %}
              <div class="product-form-wrapper" {{ block.shopify_attributes }} style="margin-top: 1.5rem; max-width: 400px;">
                {%- assign form_id = 'featured-product-form-' | append: section.id -%}
                {%- form 'product', product, id: form_id, class: 'product-form' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="FeaturedVariantId-{{ section.id }}">
                  <div style="margin-bottom: 1rem;">
                    {{ form | payment_terms }}
                  </div>
                  
                  <button type="submit" name="add" class="button button--full-width featured-product-submit" style="width: 100%; background: var(--color-accent); color: #fff; border: none; padding: 1.25rem; cursor: pointer; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.15em; font-family: inherit;" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                    <span>
                      {% if product.selected_or_first_available_variant.available %}
                        Add to cart
                      {% else %}
                        Sold out
                      {% endif %}
                    </span>
                  </button>
                  
                  {% if block.settings.show_dynamic_checkout %}
                    <div style="margin-top: 0.75rem;">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                {%- endform -%}
              </div>
            {% endif %}
            
          {% when 'custom_liquid' %}
            <div class="featured-product__custom-liquid" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>
            
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {% if product != blank %}
    <script type="application/json" id="FeaturedProductVariants-{{ section.id }}">
      {{ product.variants | json }}
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const selects = document.querySelectorAll('#shopify-section-{{ section.id }} .featured-product-option-select');
        const variantInput = document.getElementById('FeaturedVariantId-{{ section.id }}');
        const variantsJson = document.getElementById('FeaturedProductVariants-{{ section.id }}');
        
        if (selects.length > 0 && variantInput && variantsJson) {
          const variants = JSON.parse(variantsJson.textContent);
          
          function updateFeaturedVariant() {
            const selectedOptions = Array.from(selects).map(s => s.value);
            const matchedVariant = variants.find(v => {
              return v.options.every((opt, index) => opt === selectedOptions[index]);
            });
            
            const btn = document.querySelector('#shopify-section-{{ section.id }} .featured-product-submit');
            const btnSpan = btn ? btn.querySelector('span') : null;
            
            if (matchedVariant) {
              variantInput.value = matchedVariant.id;
              if (btn) {
                btn.disabled = !matchedVariant.available;
                if (btnSpan) btnSpan.innerText = matchedVariant.available ? 'Add to cart' : 'Sold out';
              }
              
              // Update Price
              const priceContainer = document.querySelector('#shopify-section-{{ section.id }} .featured-product__price .price');
              if (priceContainer) {
                const formatMoney = (cents) => '$' + (cents / 100).toFixed(2);
                if (matchedVariant.compare_at_price > matchedVariant.price) {
                  priceContainer.innerHTML = `<span class="price__regular" style="color:var(--color-accent); font-weight:600;">${formatMoney(matchedVariant.price)}</span> <s class="price__compare" style="color:#999; font-size:0.85em; margin-left:0.5rem;">${formatMoney(matchedVariant.compare_at_price)}</s>`;
                } else {
                  priceContainer.innerHTML = `<span class="price__regular" style="font-weight:600;">${formatMoney(matchedVariant.price)}</span>`;
                }
              }
            } else {
              if (btn) {
                btn.disabled = true;
                if (btnSpan) btnSpan.innerText = 'Unavailable';
              }
            }
          }
          
          selects.forEach(select => {
            select.addEventListener('change', updateFeaturedVariant);
          });
        }
      });
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout buttons"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add app snippets or other Liquid code to create advanced customizations."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "buy_buttons" },
        { "type": "description" }
      ]
    }
  ]
}
{% endschema %}
