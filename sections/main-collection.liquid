<style>
  .main-collection-wrapper { max-width: 1600px; margin: 0 auto; padding: 2rem 5%; }
  @media (min-width: 768px) { .main-collection-wrapper { padding: 4rem 5%; } }
</style>
<div class="main-collection main-collection-wrapper">
  
  <div class="collection-layout" style="align-items: flex-start;">
    
    <style>
      .collection-layout { display: flex; flex-direction: column; width: 100%; overflow: hidden; gap: 1.5rem; }
      @media (min-width: 990px) { .collection-layout { flex-direction: row; overflow: visible; gap: 4rem; } }
      .collection-sidebar { display: none; flex: 0 0 250px; width: 100%; }
      @media (min-width: 990px) { .collection-sidebar { display: block; } }
      .collection-content { flex: 1; width: 100%; max-width: 100%; min-width: 0; }
    </style>
    <!-- Left Sidebar: Filters -->
    <aside class="collection-sidebar">
      
      <h3 style="font-family: var(--font-heading-family); font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-text); margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #e5e0d8;">FILTERS</h3>

      <form id="CollectionFiltersForm" class="filter-form">
        {%- for filter in collection.filters -%}
          <div class="filter-group" style="margin-bottom: 2.5rem; border-bottom: 1px solid #f0f0f0; padding-bottom: 2rem;">
            <h4 class="filter-group-toggle" style="font-family: var(--font-heading-family); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none;">
              {{ filter.label }}
              <svg class="toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <line class="plus-vertical" x1="12" y1="5" x2="12" y2="19" style="display: none;"></line>
              </svg>
            </h4>
            
            <div class="filter-group-content">
            {%- case filter.type -%}
              {%- when 'boolean' or 'list' -%}
                <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                  {%- for value in filter.values -%}
                    <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; color: {% if value.count == 0 and value.active == false %}#ccc{% else %}#666{% endif %}; font-size: 0.9rem;">
                      <input type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        id="Filter-{{ filter.label | escape }}-{{ forloop.index }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        onchange="document.getElementById('CollectionFiltersForm').submit();"
                        style="accent-color: var(--color-accent); width: 16px; height: 16px; border: 1px solid #ccc;"
                      >
                      {{ value.label | escape }} ({{ value.count }})
                    </label>
                  {%- endfor -%}
                </div>
              {%- when 'price_range' -%}
                <div class="filter-price" style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="font-size: 0.9rem; color: #666;">$</span>
                  <input name="{{ filter.min_value.param_name }}"
                    id="Filter-{{ filter.label | escape }}-GTE"
                    {%- if filter.min_value.value -%}
                      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                    {%- endif -%}
                    type="number"
                    placeholder="0"
                    min="0"
                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    onchange="document.getElementById('CollectionFiltersForm').submit();"
                    style="width: 100%; padding: 0.5rem; border: 1px solid #e5e0d8; font-family: var(--font-body-family); font-size: 0.9rem;"
                  >
                  <span style="font-size: 0.9rem; color: #666;">- $</span>
                  <input name="{{ filter.max_value.param_name }}"
                    id="Filter-{{ filter.label | escape }}-LTE"
                    {%- if filter.max_value.value -%}
                      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                    {%- endif -%}
                    type="number"
                    min="0"
                    placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    onchange="document.getElementById('CollectionFiltersForm').submit();"
                    style="width: 100%; padding: 0.5rem; border: 1px solid #e5e0d8; font-family: var(--font-body-family); font-size: 0.9rem;"
                  >
                </div>
            {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
        {%- assign has_price_filter = false -%}
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- assign has_price_filter = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- unless has_price_filter -%}
          {%- comment -%} Fallback price filter — JS-powered client-side {%- endcomment -%}
          <div class="filter-group" style="margin-bottom: 2.5rem; border-bottom: 1px solid #f0f0f0; padding-bottom: 2rem;">
            <h4 class="filter-group-toggle" style="font-family: var(--font-heading-family); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none;">
              PRICE
              <svg class="toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <line class="plus-vertical" x1="12" y1="5" x2="12" y2="19" style="display: none;"></line>
              </svg>
            </h4>
            <div class="filter-group-content">
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="font-size: 0.85rem; color: #666; min-width: 28px;">Min</span>
                  <div style="position: relative; flex: 1;">
                    <span style="position: absolute; left: 0.5rem; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: #999;">$</span>
                    <input 
                      type="number" 
                      id="PriceFilterMin"
                      placeholder="0"
                      min="0"
                      style="width: 100%; padding: 0.5rem 0.5rem 0.5rem 1.5rem; border: 1px solid #e5e0d8; font-family: var(--font-body-family); font-size: 0.85rem; background: transparent;"
                    >
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span style="font-size: 0.85rem; color: #666; min-width: 28px;">Max</span>
                  <div style="position: relative; flex: 1;">
                    <span style="position: absolute; left: 0.5rem; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: #999;">$</span>
                    <input 
                      type="number" 
                      id="PriceFilterMax"
                      placeholder="Any"
                      min="0"
                      style="width: 100%; padding: 0.5rem 0.5rem 0.5rem 1.5rem; border: 1px solid #e5e0d8; font-family: var(--font-body-family); font-size: 0.85rem; background: transparent;"
                    >
                  </div>
                </div>
                <p id="price-filter-count" style="font-size: 0.75rem; color: var(--color-accent); margin: 0; display: none;"></p>
              </div>
            </div>
          </div>
        {%- endunless -%}

        <input type="hidden" name="sort_by" id="SortByHidden" value="{{ collection.sort_by | default: collection.default_sort_by }}">
        <button type="submit" class="button" style="width: 100%; margin-top: 1rem; background-color: var(--color-accent); color: #fff; border: none; padding: 1rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;">
          Apply Filters
        </button>
      </form>
    </aside>
    
    <!-- Right Content: Grid -->
    <div class="collection-content">
      
      <!-- Category Tabs -->
      <div class="collection-tabs" style="display: flex; gap: 2rem; margin-bottom: 2.5rem; border-bottom: 1px solid #E5E0D8; padding-bottom: 1rem; overflow-x: auto; white-space: nowrap;">
        <button data-filter="all" class="collection-tab active" style="background: none; border: none; cursor: pointer; color: var(--color-text); font-family: var(--font-heading-family); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; position: relative; padding: 0;">
          ALL
          <span class="tab-indicator" style="position: absolute; bottom: -17px; left: 0; width: 100%; height: 2px; background: var(--color-text);"></span>
        </button>
        <button data-filter="men" class="collection-tab" style="background: none; border: none; cursor: pointer; color: #999; font-family: var(--font-heading-family); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 400; position: relative; padding: 0;">
          MEN
          <span class="tab-indicator" style="position: absolute; bottom: -17px; left: 0; width: 100%; height: 2px; background: var(--color-text); display: none;"></span>
        </button>
        <button data-filter="women" class="collection-tab" style="background: none; border: none; cursor: pointer; color: #999; font-family: var(--font-heading-family); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 400; position: relative; padding: 0;">
          WOMEN
          <span class="tab-indicator" style="position: absolute; bottom: -17px; left: 0; width: 100%; height: 2px; background: var(--color-text); display: none;"></span>
        </button>
      </div>
      
      <!-- Toolbar -->
      <div class="collection-toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; flex-wrap: wrap; gap: 1rem;">
        <div style="font-size: 0.75rem; letter-spacing: 0.1em; color: #666; text-transform: uppercase; font-weight: 600;">
          {{ collection.products_count }} PRODUCTS
        </div>
        
        <div style="display: flex; align-items: center; gap: 2rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <span style="font-size: 0.75rem; letter-spacing: 0.1em; color: #666; text-transform: uppercase;">SORT BY</span>
            <select id="SortBySelect" onchange="document.getElementById('SortByHidden').value = this.value; document.getElementById('CollectionFiltersForm').submit();" style="border: 1px solid #e5e0d8; padding: 0.75rem 2rem 0.75rem 1rem; font-family: var(--font-body-family); font-size: 0.85rem; color: var(--color-text); background: transparent; appearance: none; outline: none;">
              {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
          </div>
          
          <div style="display: flex; gap: 0.5rem; color: #999;">
            <button id="btn-grid-view" aria-label="Grid View" style="background: transparent; border: 1px solid var(--color-accent); color: var(--color-accent); padding: 0.5rem; display: flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 2px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            </button>
            <button id="btn-list-view" aria-label="List View" style="background: transparent; border: none; color: inherit; padding: 0.5rem; display: flex; align-items: center; justify-content: center; cursor: pointer;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            </button>
          </div>
        </div>
      </div>
      
      <!-- Product Grid -->
      <style>
        .grid-4-special {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 1rem;
        }
        @media (min-width: 600px) {
          .grid-4-special { 
            grid-template-columns: repeat(2, 1fr); 
            gap: 2rem;
          }
        }
        @media (min-width: 1200px) {
          .grid-4-special { grid-template-columns: repeat(4, 1fr); }
        }
        .list-view-active {
          grid-template-columns: 1fr !important;
        }
        .list-view-active .filterable-product {
          width: 100%;
        }
        .list-view-active .product-card {
          display: grid !important;
          grid-template-columns: 120px 1fr !important;
          gap: 1rem !important;
          align-items: start !important; 
          text-align: left !important;
          background: #fff !important;
          border: 1px solid #e5e0d8 !important;
          padding: 1rem !important;
        }
        @media (min-width: 600px) {
          .list-view-active .product-card {
            grid-template-columns: 250px 1fr !important;
            gap: 2.5rem !important;
            align-items: center !important;
            padding: 1.5rem !important;
          }
        }
        .list-view-active .product-card__image-wrapper {
          width: 100% !important;
          height: auto !important;
          padding-bottom: 0 !important; /* Remove any aspect ratio padding hacks */
          aspect-ratio: 3 / 4 !important;
          margin: 0 !important;
          position: relative !important;
          overflow: hidden !important;
        }
        .list-view-active .product-card__image-wrapper img {
          position: absolute !important;
          top: 0 !important;
          left: 0 !important;
          width: 100% !important;
          height: 100% !important;
          object-fit: cover !important;
        }
        .list-view-active .product-card__info-wrapper {
          display: flex !important;
          flex-direction: column !important;
          justify-content: center !important;
          margin: 0 !important;
          width: 100% !important;
        }
        .list-view-active .product-card__options {
          grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)) !important;
          max-width: 100% !important;
          gap: 0.5rem !important;
        }
        @media (min-width: 600px) {
          .list-view-active .product-card__options {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)) !important;
            gap: 1rem !important;
          }
        }
        .list-view-active .product-card__quick-add {
          max-width: 300px;
          margin-top: 1rem;
        }
        @media (max-width: 768px) {
          .list-view-active .product-card {
            flex-direction: column;
            text-align: center;
          }
          .list-view-active .product-card__image-wrapper {
            width: 100%;
          }
          .list-view-active .product-card__quick-add {
            max-width: 100%;
          }
        }
      </style>
      <!-- Active Filters -->
      <div class="active-filters" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; align-items: center;">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a class="active-filters__clear-filter" href="{{ value.url_to_remove }}" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #E5E0D8; padding: 0.35rem 0.85rem; border-radius: 20px; font-size: 0.75rem; text-decoration: none; color: var(--color-text); border: 1px solid #dcd6cd; transition: all 0.2s ease;">
              {{ filter.label }}: {{ value.label }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top: 1px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </a>
          {%- endfor -%}
          {%- if filter.type == "price_range" -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <a class="active-filters__clear-filter" href="{{ filter.url_to_remove }}" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #E5E0D8; padding: 0.35rem 0.85rem; border-radius: 20px; font-size: 0.75rem; text-decoration: none; color: var(--color-text); border: 1px solid #dcd6cd; transition: all 0.2s ease;">
                {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}0{%- endif -%}-{%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top: 1px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign has_active_filters = false -%}
        {%- for filter in collection.filters -%}
          {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}
            {%- assign has_active_filters = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_active_filters -%}
          <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="active-filters__clear-all" style="font-size: 0.75rem; color: var(--color-accent); text-decoration: underline; font-weight: 600; margin-left: 0.5rem;">Clear all</a>
        {%- endif -%}
      </div>

      {% paginate collection.products by 36 %}
        <div id="product-grid-container" class="grid-4-special reveal-stagger-container">
          {% if collection.products.size > 0 %}
            {% for product in collection.products %}
              {% assign product_category = 'all' %}
              {% assign downcase_title = product.title | downcase %}
              {% assign downcase_tags = product.tags | join: ' ' | downcase %}
              {% assign downcase_type = product.type | downcase %}
              
              {% if downcase_title contains 'women' or downcase_tags contains 'women' or downcase_type contains 'women' %}
                {% assign product_category = 'women' %}
              {% elsif downcase_title contains 'men ' or downcase_title contains 'men' or downcase_tags contains 'men' or downcase_type contains 'men' %}
                {% assign product_category = 'men' %}
              {% else %}
                 {% assign product_category = 'all' %}
              {% endif %}

              <div class="filterable-product reveal-stagger-child" data-category="{{ product_category }}" data-price="{{ product.price }}">
                {% render 'product-card', product: product %}
              </div>
            {% endfor %}
          {% else %}
            {% assign has_active_filters = false %}
            {% for filter in collection.filters %}
              {% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}
                {% assign has_active_filters = true %}
              {% endif %}
            {% endfor %}
            
            {% if has_active_filters %}
              <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">
                <p style="font-size: 1.1rem; color: #666; margin-bottom: 1rem;">No products found matching your filters.</p>
                <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="button" style="background-color: var(--color-accent); color: #fff; padding: 0.8rem 1.5rem; text-decoration: none; display: inline-block;">
                  Clear Filters
                </a>
              </div>
            {% else %}
              <!-- DUMMY DATA FOR DEMO PURPOSES -->
              <div class="filterable-product reveal-stagger-child" data-category="men">{% render 'product-card', fallback_index: 1 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="men">{% render 'product-card', fallback_index: 2 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="women">{% render 'product-card', fallback_index: 3 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="men">{% render 'product-card', fallback_index: 4 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="women">{% render 'product-card', fallback_index: 5 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="women">{% render 'product-card', fallback_index: 6 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="women">{% render 'product-card', fallback_index: 7 %}</div>
              <div class="filterable-product reveal-stagger-child" data-category="men">{% render 'product-card', fallback_index: 8 %}</div>
            {% endif %}
          {% endif %}
        </div>
        
        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
          <div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 6rem; font-size: 0.8rem; color: #666;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {% endpaginate %}
      
    </div>
    
  </div>
</div>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.collection-tab');
    const products = document.querySelectorAll('.filterable-product');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        const filter = this.getAttribute('data-filter');
        
        // Update tabs styling
        tabs.forEach(t => {
          t.classList.remove('active');
          t.style.fontWeight = '400';
          t.style.color = '#999';
          t.querySelector('.tab-indicator').style.display = 'none';
        });
        
        this.classList.add('active');
        this.style.fontWeight = '600';
        this.style.color = 'var(--color-text)';
        this.querySelector('.tab-indicator').style.display = 'block';
        
        // Filter products
        if (products.length > 0) {
          let visibleCount = 0;
          products.forEach(product => {
            if (filter === 'all' || product.getAttribute('data-category') === filter) {
              product.style.display = 'block';
              visibleCount++;
            } else {
              product.style.display = 'none';
            }
          });
          
          // Optionally update product count if there is a counter element
          const countEl = document.querySelector('.collection-toolbar div:first-child');
          if (countEl && countEl.innerText.includes('PRODUCTS')) {
            countEl.innerText = visibleCount + ' PRODUCTS';
          }
        }
      });
    });

    // Check URL hash for filter on load
    if (window.location.hash === '#filter-men') {
      const menTab = document.querySelector('[data-filter="men"]');
      if (menTab) setTimeout(() => menTab.click(), 50);
    } else if (window.location.hash === '#filter-women') {
      const womenTab = document.querySelector('[data-filter="women"]');
      if (womenTab) setTimeout(() => womenTab.click(), 50);
    }

    const gridBtn = document.getElementById('btn-grid-view');
    const listBtn = document.getElementById('btn-list-view');
    const gridContainer = document.getElementById('product-grid-container');

    if(gridBtn && listBtn && gridContainer) {
      gridBtn.addEventListener('click', function() {
        gridContainer.classList.remove('list-view-active');
        gridBtn.style.border = '1px solid var(--color-accent)';
        gridBtn.style.color = 'var(--color-accent)';
        listBtn.style.border = 'none';
        listBtn.style.color = 'inherit';
      });

      listBtn.addEventListener('click', function() {
        gridContainer.classList.add('list-view-active');
        listBtn.style.border = '1px solid var(--color-accent)';
        listBtn.style.color = 'var(--color-accent)';
        gridBtn.style.border = 'none';
        gridBtn.style.color = 'inherit';
      });
    }

    const filterToggles = document.querySelectorAll('.filter-group-toggle');
    filterToggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const plusLine = this.querySelector('.plus-vertical');
        if (content.style.display === 'none') {
          content.style.display = 'block';
          plusLine.style.display = 'none';
        } else {
          content.style.display = 'none';
          plusLine.style.display = 'block';
        }
      });
    });
    // ── Client-side Price Filter ──────────────────────────────────────
    const applyBtn = document.querySelector('#CollectionFiltersForm button[type="submit"]');
    const minInput = document.getElementById('PriceFilterMin');
    const maxInput = document.getElementById('PriceFilterMax');
    const priceCountEl = document.getElementById('price-filter-count');

    if (applyBtn && minInput && maxInput) {
      applyBtn.addEventListener('click', function(e) {
        const minVal = parseFloat(minInput.value) || 0;
        const maxVal = parseFloat(maxInput.value) || Infinity;

        // Only intercept if price filter fields are filled in
        if (minInput.value !== '' || maxInput.value !== '') {
          e.preventDefault(); // stop normal form submit

          const products = document.querySelectorAll('.filterable-product[data-price]');
          let visible = 0;

          products.forEach(function(card) {
            // Shopify stores price in cents (e.g. 108900 = $1089.00)
            const priceCents = parseInt(card.getAttribute('data-price'), 10);
            const priceDollars = priceCents / 100;

            const inRange = priceDollars >= minVal && priceDollars <= maxVal;
            card.style.display = inRange ? '' : 'none';
            if (inRange) visible++;
          });

          // Update count display
          const countEl = document.querySelector('.collection-toolbar div:first-child');
          if (countEl) countEl.innerText = visible + ' PRODUCTS';

          if (priceCountEl) {
            priceCountEl.style.display = 'block';
            priceCountEl.textContent = visible + ' products in $' + minVal + ' – ' + (maxVal === Infinity ? 'Any' : '$' + maxVal);
          }
        }
      });

      // Reset price filter when inputs are cleared
      [minInput, maxInput].forEach(function(inp) {
        inp.addEventListener('input', function() {
          if (minInput.value === '' && maxInput.value === '') {
            document.querySelectorAll('.filterable-product[data-price]').forEach(function(c) {
              c.style.display = '';
            });
            if (priceCountEl) priceCountEl.style.display = 'none';
          }
        });
      });
    }
  });
</script>

