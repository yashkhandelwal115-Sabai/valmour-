<div class="blog-page">
  <h1>{{ blog.title }}</h1>
  {% paginate blog.articles by 12 %}
  <div class="blog-page__grid grid grid-3">
    {% for article in blog.articles %}
      <div class="blog-page__item">
        <a href="{{ article.url }}">
          {% if article.image %}
            {{ article.image | image_url: width: 600 | image_tag }}
          {% endif %}
          <h2>{{ article.title }}</h2>
          <p>{{ article.published_at | time_tag: format: 'date' }}</p>
          <div class="blog-page__excerpt">
            {{ article.excerpt_or_content }}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
  
  {%- if paginate.pages > 1 -%}
    <div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 4rem; font-size: 0.8rem; color: #666;">
      {{ paginate | default_pagination }}
    </div>
  {%- endif -%}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
