<div class="product-page">
  <div class="product-page__container">
    <div class="product-page__media-gallery">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          <div class="product-page__media-item" data-media-id="{{ media.id }}">
            {{ media | image_url: width: 1200 | image_tag: loading: 'lazy' }}
          </div>
        {% endfor %}
      {% else %}
        <div class="product-page__media-item">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <div class="product-page__info-wrapper">
      <div class="product-page__info">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'vendor' %}
              <div class="product-page__vendor" {{ block.shopify_attributes }}>
                {{ product.vendor }}
              </div>
            {% when 'title' %}
              <h1 class="product-page__title" {{ block.shopify_attributes }}>
                {{ product.title }}
              </h1>
            {% when 'price' %}
              <div class="product-page__price" {{ block.shopify_attributes }}>
                {% render 'price', product: product %}
              </div>
            {% when 'description' %}
              <div class="product-page__description" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {% when 'buy_buttons' %}
              <div class="product-page__form-wrapper" {{ block.shopify_attributes }}>
                <form method="post" action="{{ routes.cart_add_url }}" id="product-form-{{ section.id }}" class="product-form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="VariantId-{{ section.id }}">
                  <script type="application/json" id="ProductVariants-{{ section.id }}">
                    {{ product.variants | json }}
                  </script>
                  
                  {% unless product.has_only_default_variant %}
                    <div class="product-form__variants">
                      {% for option in product.options_with_values %}
                        <div class="product-form__option">
                          <label class="product-form__option-name">{{ option.name }}</label>
                          <div class="product-form__swatches">
                            {% assign downcase_name = option.name | downcase %}
                            {% if downcase_name == 'size' %}
                              <div class="size-swatches-container">
                                {% assign all_sizes = "XS,S,M,L,XL" | split: "," %}
                                {% for f_size in all_sizes %}
                                  {% assign is_available = false %}
                                  {% assign size_exists_in_product = false %}
                                  {% for variant in product.variants %}
                                    {% assign opt_idx = option.position | minus: 1 %}
                                    {% if variant.options[opt_idx] == f_size %}
                                      {% assign size_exists_in_product = true %}
                                      {% if variant.available %}
                                        {% assign is_available = true %}
                                      {% endif %}
                                    {% endif %}
                                  {% endfor %}
                                  <div class="size-swatch-item {% unless is_available %}is-sold-out{% endunless %}" data-option-position="{{ option.position | minus: 1 }}" data-value="{{ f_size | escape }}">
                                    <input type="radio" 
                                           id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                           name="options[{{ option.name | escape }}]"
                                           value="{{ f_size | escape }}"
                                           {% if option.selected_value == f_size and is_available %}checked{% endif %}
                                           class="visually-hidden"
                                           {% unless is_available %}disabled{% endunless %}>
                                    <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="size-swatch-label">
                                      {{ f_size }}
                                    </label>
                                    <span class="size-swatch-status {% if is_available %}in-stock{% else %}out-of-stock{% endif %}">
                                      {% if is_available %}In stock{% else %}Out of stock{% endif %}
                                    </span>
                                  </div>
                                {% endfor %}
                              </div>
                            {% else %}
                              {% for value in option.values %}
                                <input type="radio" 
                                       id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                       name="options[{{ option.name | escape }}]"
                                       value="{{ value | escape }}"
                                       {% if option.selected_value == value %}checked{% endif %}
                                       class="visually-hidden">
                                <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="product-form__swatch-label">
                                  {{ value }}
                                </label>
                              {% endfor %}
                            {% endif %}
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  {% endunless %}

                  <div class="product-form__quantity">
                    <label for="Quantity-{{ section.id }}" class="visually-hidden">Quantity</label>
                    <div class="quantity-input">
                      <button class="quantity-input__btn quantity-input__btn--minus" type="button" aria-label="Decrease">&minus;</button>
                      <input class="quantity-input__field" type="number" name="quantity" id="Quantity-{{ section.id }}" min="1" value="1" form="product-form-{{ section.id }}">
                      <button class="quantity-input__btn quantity-input__btn--plus" type="button" aria-label="Increase">&plus;</button>
                    </div>
                  </div>

                  <div class="product-form__actions">
                    <button type="submit" class="button button--full-width product-form__submit"
                      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                    >
                      <span>
                        {% if product.selected_or_first_available_variant.available %}
                          Add to cart
                        {% else %}
                          Sold out
                        {% endif %}
                      </span>
                    </button>
                    {% if block.settings.show_dynamic_checkout %}
                      {{ form | payment_button }}
                    {% endif %}
                  </div>
                </form>
              </div>

              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  // Quantity Logic
                  const qtyMinus = document.querySelector('.quantity-input__btn--minus');
                  const qtyPlus = document.querySelector('.quantity-input__btn--plus');
                  const qtyInput = document.querySelector('.quantity-input__field');

                  if (qtyMinus && qtyPlus && qtyInput) {
                    qtyMinus.addEventListener('click', function() {
                      let val = parseInt(qtyInput.value, 10) || 1;
                      if (val > 1) qtyInput.value = val - 1;
                    });
                    qtyPlus.addEventListener('click', function() {
                      let val = parseInt(qtyInput.value, 10) || 1;
                      qtyInput.value = val + 1;
                    });
                  }

                  // Variant Logic
                  const radios = document.querySelectorAll('input[type="radio"][name^="options"]');
                  const variantInput = document.getElementById('VariantId-{{ section.id }}');
                  const variantsJson = document.getElementById('ProductVariants-{{ section.id }}');
                  
                  if (radios.length > 0 && variantInput && variantsJson) {
                    const variants = JSON.parse(variantsJson.textContent);
                    radios.forEach(radio => {
                      radio.addEventListener('change', function() {
                        const selectedOptions = Array.from(document.querySelectorAll('input[type="radio"][name^="options"]:checked')).map(r => r.value);
                        
                        const matchedVariant = variants.find(v => {
                          return v.options.every((opt, index) => opt === selectedOptions[index]);
                        });
                        
                        if (matchedVariant) {
                          variantInput.value = matchedVariant.id;
                          const url = new URL(window.location.href);
                          url.searchParams.set('variant', matchedVariant.id);
                          window.history.replaceState({}, '', url.toString());
                          
                          const btn = document.querySelector('.product-form__submit');
                          if (btn) {
                            btn.disabled = !matchedVariant.available;
                            btn.querySelector('span').innerText = matchedVariant.available ? 'Add to cart' : 'Sold out';
                          }

                          // Update Price
                          const priceContainer = document.querySelector('.product-page__price .price');
                          if (priceContainer) {
                            let priceHtml = '';
                            const formatMoney = (cents) => '$' + (cents / 100).toFixed(2);
                            if (matchedVariant.compare_at_price > matchedVariant.price) {
                              priceHtml = `<span class="price__regular" style="color:var(--color-accent);">${formatMoney(matchedVariant.price)}</span> <s class="price__compare">${formatMoney(matchedVariant.compare_at_price)}</s>`;
                            } else {
                              priceHtml = `<span class="price__regular">${formatMoney(matchedVariant.price)}</span>`;
                            }
                            priceContainer.innerHTML = priceHtml;
                          }

                          // Update Image
                          if (matchedVariant.featured_media) {
                            const targetId = matchedVariant.featured_media.id;
                            const targetMedia = document.querySelector(`.product-page__media-item[data-media-id="${targetId}"]`);
                            if (targetMedia) {
                               targetMedia.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            }
                          }
                          
                          // Update SKU
                          const skuEl = document.querySelector('.product-page__sku');
                          if (skuEl) skuEl.innerText = matchedVariant.sku || '';

                          // Update Inventory
                          const invEl = document.querySelector('.product-page__inventory');
                          if (invEl) {
                             if (!matchedVariant.available) invEl.innerText = 'Out of stock';
                             else invEl.innerText = matchedVariant.inventory_quantity > 0 ? `${matchedVariant.inventory_quantity} in stock` : 'In stock';
                          }

                        } else {
                          const btn = document.querySelector('.product-form__submit');
                          if (btn) {
                            btn.disabled = true;
                            btn.querySelector('span').innerText = 'Unavailable';
                          }
                        }

                        // Update swatch availability states
                        const swatchItems = document.querySelectorAll('.size-swatch-item');
                        swatchItems.forEach(item => {
                          const position = parseInt(item.getAttribute('data-option-position'));
                          const value = item.getAttribute('data-value');
                          
                          const testOptions = [...selectedOptions];
                          testOptions[position] = value;
                          
                          const testVariant = variants.find(v => {
                            return v.options.every((val, idx) => val === testOptions[idx]);
                          });
                          
                          const statusSpan = item.querySelector('.size-swatch-status');
                          if (testVariant && testVariant.available) {
                            item.classList.remove('is-sold-out');
                            if (statusSpan) {
                              statusSpan.className = 'size-swatch-status in-stock';
                              statusSpan.innerText = 'In stock';
                            }
                          } else {
                            item.classList.add('is-sold-out');
                            if (statusSpan) {
                              statusSpan.className = 'size-swatch-status out-of-stock';
                              statusSpan.innerText = 'Out of stock';
                            }
                          }
                        });
                      });
                    });
                  }
                });
              </script>
            {% when 'custom_liquid' %}
              <div class="product-page__custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>
            {% when '@app' %}
              {% render block %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Information",
  "settings": [],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { 
      "type": "buy_buttons", 
      "name": "Buy Buttons", 
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout buttons"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }
      ]
    }
  ]
}
{% endschema %}
