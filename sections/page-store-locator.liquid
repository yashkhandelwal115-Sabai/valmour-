<div class="page-width" style="max-width: 1200px; margin: 0 auto; padding: 4rem 5%;">
  <h1 style="font-family: var(--font-heading-family); font-size: 3rem; margin-bottom: 1.5rem; text-transform: uppercase; text-align: center;">Store Locator</h1>
  <p style="color: #666; max-width: 600px; margin: 0 auto 4rem; line-height: 1.8; text-align: center;">Find a Velour boutique near you to experience our collections in person and get expert styling advice.</p>
  
  {% style %}
    @media (min-width: 768px) {
      .locator-grid { grid-template-columns: 1fr 1.5fr !important; }
    }
  {% endstyle %}
  
  <div class="locator-grid" style="display: grid; grid-template-columns: 1fr; gap: 2rem; border: 1px solid #E5E0D8; border-radius: 8px; overflow: hidden;">
    <div style="padding: 3rem; background: #FAF8F5;">
      <h3 style="font-family: var(--font-heading-family); font-size: 1.5rem; margin-bottom: 0.5rem;">New York Flagship</h3>
      <p style="color: #666; margin-bottom: 2rem; font-size: 0.9rem;">123 Fashion Avenue<br>New York, NY 10001<br>United States</p>
      
      <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">Hours</h4>
      <p style="color: #666; margin-bottom: 2rem; font-size: 0.9rem; line-height: 1.6;">Mon-Sat: 10AM - 8PM<br>Sunday: 11AM - 6PM</p>
      
      <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">Contact</h4>
      <p style="color: #666; font-size: 0.9rem;">+1 (555) 123-4567<br>ny-store@velour.com</p>
    </div>
    
    <div style="height: 100%; min-height: 400px; background: url('https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=1000&auto=format&fit=crop') center/cover no-repeat;">
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Store Locator",
  "settings": []
}
{% endschema %}
