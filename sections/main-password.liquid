{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'velour.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <div class="password-page" style="max-width: 600px; margin: 6rem auto; text-align: center; padding: 2rem;">
      <h1 style="font-family: var(--font-heading-family); margin-bottom: 2rem;">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 200 | image_tag }}
        {% else %}
          {{ shop.name }}
        {% endif %}
      </h1>
      <p style="color: #666; margin-bottom: 3rem;">{{ shop.password_message }}</p>
      
      {% form 'customer', class: 'password-newsletter' %}
        {% if form.posted_successfully? %}
          <p class="password-newsletter__success" style="color: #4CAF50; margin-bottom: 3rem; font-weight: 600;">You will be notified when we launch!</p>
        {% else %}
          <p style="margin-bottom: 1rem; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text);">Be the first to know when we launch:</p>
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          <div style="display: flex; gap: 0.5rem; justify-content: center; max-width: 400px; margin: 0 auto 3rem;">
            <input type="email" name="contact[email]" placeholder="Enter your email" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e5e0d8; font-size: 0.9rem; border-radius: 0; background: #fff;">
            <button type="submit" class="button" style="background-color: var(--color-accent); color: #fff; border: none; padding: 0.75rem 1.5rem; text-transform: uppercase; cursor: pointer; font-size: 0.8rem; font-family: inherit;">Notify me</button>
          </div>
        {% endif %}
      {% endform %}
      
      <div style="border-top: 1px solid #e5e0d8; padding-top: 3rem; margin-top: 3rem;">
        <h3 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;">Enter Store Using Password</h3>
        {% form 'storefront_password' %}
          <div style="display: flex; gap: 0.5rem; justify-content: center; max-width: 400px; margin: 0 auto;">
            <input type="password" name="password" id="password" placeholder="Password" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e5e0d8; font-size: 0.9rem; border-radius: 0; background: #fff;" autofocus>
            <button type="submit" class="button" style="background-color: #000; color: #fff; border: none; padding: 0.75rem 1.5rem; text-transform: uppercase; cursor: pointer; font-size: 0.8rem; font-family: inherit;">Enter</button>
          </div>
        {% endform %}
      </div>
    </div>
  </body>
</html>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}
